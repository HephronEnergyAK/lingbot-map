{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingbot-map.invalid/schemas/runtime-identity-1.0.0.json",
  "title": "LingBot Map Worker Runtime Identity",
  "type": "object",
  "required": ["identity_version", "runtime_id", "inputs"],
  "properties": {
    "identity_version": { "const": 1 },
    "runtime_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "length", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
