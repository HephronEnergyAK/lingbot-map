{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://lingbot-map.invalid/schemas/job-status/1.0.0",
  "title": "LingBot Map Job Status 1.0.0", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "job_id", "state", "phase", "heartbeat_sequence", "heartbeat_utc", "worker_monotonic", "progress_event_sequence", "progress", "error"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "job_id": {"type": "string", "pattern": "^job-[0-9a-f]{32}$"},
    "state": {"enum": ["starting", "running", "cancelling", "succeeded", "cancelled", "failed"]}, "phase": {"type": "string", "minLength": 1, "maxLength": 256},
    "heartbeat_sequence": {"type": "integer", "minimum": 0}, "heartbeat_utc": {"type": "string", "format": "date-time"}, "worker_monotonic": {"type": "number", "minimum": 0},
    "progress_event_sequence": {"type": "integer", "minimum": 0}, "progress": {"type": "object", "additionalProperties": false, "required": ["completed", "total", "eta_seconds"], "properties": {
      "completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "eta_seconds": {"type": ["number", "null"], "minimum": 0}
    }}, "error": {"type": ["string", "null"], "maxLength": 16384}
  }
}
